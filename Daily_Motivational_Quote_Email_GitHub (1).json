{
  "name": "Daily Motivational Quote Email",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7,
              "triggerAtMinute": 35
            }
          ]
        }
      },
      "name": "Every Morning at 7:35am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://zenquotes.io/api/today",
        "options": {}
      },
      "name": "Fetch Daily Quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=Your Daily Motivation - {{ $now.toFormat(\"MMMM d, yyyy\") }}",
        "message": "=<h2>Good morning!</h2><blockquote style=\"font-size:18px;font-style:italic;\">\"{{ $json.q }}\"</blockquote><p style=\"text-align:right;\">\u2014 {{ $json.a }}</p>",
        "options": {}
      },
      "name": "Send Morning Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        448,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Every Morning at 7:35am": {
      "main": [
        [
          {
            "node": "Fetch Daily Quote",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Daily Quote": {
      "main": [
        [
          {
            "node": "Send Morning Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "nodeGroups": []
}